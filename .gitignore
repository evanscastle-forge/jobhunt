.venv/
__pycache__/
*.pyc
.env
/data/
!jobhunt/data/

# Real profiles stay on the machine: profile.toml holds contact details and EEO demographics,
# notes/about.md holds a person's history, and search.toml can too. Only the example profiles are
# tracked. Copy one to profiles/<your-name>/ to start. A profile's decision log, pay figures and home
# city belong in its own folder (search.toml, notes/), never in a tracked file: this repository is public.
/profiles/*
!/profiles/example-engineer/
!/profiles/example-analyst/
profiles/*/data/
profiles/*/notes/uploads/
*.pdf
*.docx

# An older snapshot of the project that contains a resume and a filled-in profile.
/archive/jobhunt.zip

# Personal working notes: a handoff document containing a full CV.
/session_summary.md

*.corrupt.json
*.tmp

# launchd agents generated by `jobhunt.py schedule --write`: they hold absolute paths to one machine.
/deploy/*.plist

# Local Claude Code settings.
.claude/settings.local.json

# A cleanup script for one Mac's disk, not part of the tool.
/tools/purge_junk.sh
